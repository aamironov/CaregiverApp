# A DNS name whose A/AAAA record points to this VPS. Do not include https://.
APP_DOMAIN=care.example.com

# Used by Caddy for automatic HTTPS certificate notices.
ACME_EMAIL=admin@example.com

# Public Google Web OAuth client ID. Leave empty to use email/password only.
GOOGLE_CLIENT_IDS=

# Backend-only secrets. Leave empty to disable Bytez features.
BYTEZ_API_KEY=
BYTEZ_PROVIDER_KEY=
BYTEZ_BASE_URL=https://api.bytez.com/models/v2

# Optional model overrides.
BYTEZ_DOCUMENT_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
BYTEZ_SPEECH_MODEL=openai/whisper-large-v3-turbo
BYTEZ_TRANSLATION_MODEL=Qwen/Qwen3-4B
